# Gravity Dots — change these numbers to tune the hero background.
# Energy is a percentage (0–100); radius is in CSS pixels (60–480).
VITE_GRAVITY_DOTS_ENERGY=74
VITE_GRAVITY_DOTS_RADIUS=225

# ---------------------------------------------------------
# First-visit portfolio introduction
# ---------------------------------------------------------
# Choose one: system | type | ignition | commit
# Other modes: random | cycle | sequence | off
# sequence plays all FOUR (not recommended for everyday use).
# "counter" is intentionally not included.
VITE_PORTFOLIO_LOADER_STYLE=ignition

# Per-loader animation length in milliseconds (750–4000).
# With sequence, duration applies to each of the four styles.
VITE_PORTFOLIO_LOADER_DURATION_MS=1650

# Wipe/fade into the actual hero after the intro (150–950 ms).
VITE_PORTFOLIO_LOADER_EXIT_MS=440

# session: once per browser tab (default); always: every full page refresh.
VITE_PORTFOLIO_LOADER_REPLAY=session

# true: show an accessible Skip intro control and support Escape.
VITE_PORTFOLIO_LOADER_SKIPPABLE=true
